@{
    ViewData["Title"] = "Padrão Uninove";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Dados do Aluno</h2>
        </div>
        <div class="card-body">
            <p class="fs-5"><strong>Nome:</strong> @ViewBag.Nome</p>
            <p class="fs-5"><strong>Curso:</strong> @ViewBag.Curso</p>
            <p class="fs-5"><strong>Semestre:</strong> @ViewBag.Semestre</p>
        </div>
    </div>
</div>