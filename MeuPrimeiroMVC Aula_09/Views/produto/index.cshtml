@{
    ViewData["Title"] = "Lista de Produtos";
}

<div class="container mt-5">
    <h2>Nossos Produtos</h2>
    
    <table class="table table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nome</th>
                <th>Preço</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < ViewBag.Produtos.Count; i++)
            {
                // Verifica se o preço é menor que 100 para aplicar a classe do Bootstrap (verde)
                string classeLinha = "";
                if (ViewBag.Precos[i] < 100.00)
                {
                    classeLinha = "table-success"; // Classe do Bootstrap que pinta de verde
                }

                <tr class="@classeLinha">
                    <td>@(i + 1)</td>
                    <td>@ViewBag.Produtos[i]</td>
                    <td>@ViewBag.Precos[i].ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3 alert alert-secondary">
        <strong>Total: @ViewBag.Produtos.Count produtos</strong>
    </div>
</div>